import "uid://hogiw5kgfifn" as get_flower
import "uid://dt4dpnkm6fpxo" as tumor_puzzle

~ start
if CharacterData.Julio.get_status("medication_for_lucio") == 1:
	Sanson: “Estou ocupado agora.”
	=> END!
elif CharacterData.Julio.get_status("get_inkwell") == 1:
	if CharacterData.Hugo.asked_lucio_inkwell == false:
		Você: “Hugo, por acaso você tem um tinteiro?”
		do DialogueData.set_mood("Hugo", DialogueData.HugoMoods.MISCHIVEOUS_WINK)
		Hugo: “Talvez sim… talvez não. Procure em outro lugar.”
		=> END
	else:
		=> get_flower/start
elif CharacterData.Hugo.get_status("get_flower") == 2 and not CharacterData.Hugo.flower_given_to_julio:
	=> get_flower/thanks
elif CharacterData.Hugo.flower_given_to_julio:
	do DialogueData.set_mood("Hugo", DialogueData.HugoMoods.IDLE_SAD)
	Hugo: “...”

