import "uid://bjj8v02n0vgan" as medication_for_lucio
import "uid://fl7wxpluqdk4" as lucio_drunk


~ start
if not WorldStateManager.starting_cutscene_played:
	do DialogueData.set_mood("Lucio", DialogueData.LucioMoods.IDLE_SAD)
	Lucio: “Ó, Francisco. Vejo que é hora da oração. Não poderei acompanhar-vos hoje.”
	=> END!
if CharacterData.Julio.lucio_received_medicine and CharacterData.Julio.get_status("get_inkwell") == 0:
	=> thanks
elif CharacterData.Julio.get_status("medication_for_lucio") == 1:
	=> medication_for_lucio/start
elif CharacterData.Julio.get_status("get_inkwell") == 1:
	do CharacterData.Hugo.asked_lucio_inkwell = true
	Você: “Olá, Lucio. Por acaso você tem um tinteiro?”
	Lucio: “O hugo passou por aqui apressado e o levou. Ele disse que estava ‘pegando emprestado por uma questão de extrema importância’.”
elif CharacterData.Julio.get_status("get_inkwell") == 2:
	=> lucio_drunk/start
else:
	Lucio: Olá.
=> END


~ thanks
do DialogueData.set_mood("Lucio", DialogueData.LucioMoods.IDLE_DEFAULT)
Julio: “Avisou o Julio? O avise.”
=> END