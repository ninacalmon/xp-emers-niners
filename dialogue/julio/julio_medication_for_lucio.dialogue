import "uid://djib057op7qt5" as julio_get_inkwell


~ start
match CharacterData.Julio.get_status("medication_for_lucio"):
	when 0:
		=> give_task
	when 1:
		=> waiting_completion
=> END

~ give_task
do DialogueData.set_mood("Julio", DialogueData.JulioMoods.IDLE_DEFAULT)
Julio: “Ah… Francisco! Estava pensando se você-“
Você: “Julio, você não entende o significado disso, não-“
do DialogueData.set_mood("Julio", DialogueData.JulioMoods.IDLE_SAD)
Julio: “Preciso da sua ajuda. Estou preocupado com o Lucio… ele deve estar com dor. Você poderia levar este remédio para ele, por favor?”
do InventoryManager.add_new_item(CharacterData.Item.medication)
Você: “… tudo bem.”
Julio: “Espero que ele se sinta melhor logo.”
do CharacterData.Julio.give_task("medication_for_lucio")
=> END

~ waiting_completion
do DialogueData.set_mood("Julio", DialogueData.JulioMoods.IDLE_DEFAULT)
Julio: “Olá! Já fez o que eu pedi?“
- > Concluir tarefa <[if CharacterData.Julio.lucio_received_medicine /] => complete_task
- “O que era para fazer mesmo?“ => explain_task
- > Finalizar diálogo < => END!
=> END

~ explain_task
do DialogueData.set_mood("Julio", DialogueData.JulioMoods.IDLE_DEFAULT)
Julio: “Leve o remédio que lhe dei para Lucio e retorne, por favor.“
=> END

~ complete_task
do DialogueData.set_mood("Julio", DialogueData.JulioMoods.INTENSE_SAD)
Julio: “Como ele está?”
Você: “Melhor, eu acho.”
do DialogueData.set_mood("Julio", DialogueData.JulioMoods.INTENSE_HAPPY)
Julio: “Ah! Fico feliz!”
do CharacterData.Julio.complete_task("medication_for_lucio")
Você: “Na verdade, tem algo que eu gostaria de perguntar...”
Você: “Sobre o homem do confessionário… Você já o viu sair de lá?”
do DialogueData.set_mood("Julio", DialogueData.JulioMoods.SILLY_HAPPY)
Julio: “Ah. Não, nunca vi. Imagino que ele só saia para ir ao banheiro… haha. Mas isso é raro. Ele nunca come suas pequenas porções de comida. Talvez seja exigente. Haha!”
do CharacterData.Confessor.hunger = true
=> julio_get_inkwell/start

