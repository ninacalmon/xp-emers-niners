
~ start
match CharacterData.Julio.get_status("get_inkwell"):
	when 0:
		=> give_task_init
	when 1:
		=> waiting_completion
	when 2:
		Julio: "Obrigado!"
=> END

~ give_task_init
do GetEntity.put_entity_at(GetEntity.get_hugo(), GetEntity.get_hugo_room_pos().global_position)
do GetEntity.put_entity_at(GetEntity.get_sanson(), GetEntity.get_sanson_room_pos().global_position)
do GetEntity.get_hugo().stop_chatting()
do GetEntity.get_sanson().stop_chatting()
do DialogueData.set_mood("Julio", DialogueData.JulioMoods.IDLE_DEFAULT)
Julio: “Ah... espere. Francisco... preciso da sua ajuda com algo.”
do DialogueData.set_mood("Julio", DialogueData.JulioMoods.SILLY_DEFAULT)
Julio: “É, hummm... Ah sim.”
~ give_task
do DialogueData.set_mood("Julio", DialogueData.JulioMoods.IDLE_DEFAULT)
Julio: “Tinta. Eu preciso de um tinteiro, por favor.”
do DialogueData.set_mood("Julio", DialogueData.JulioMoods.IDLE_HAPPY)
Julio: “Se conseguir para mim, vou te levar até a área dos animais.”
~ question_hub
if locals.asked_ink and locals.asked_animals:
	=> finish_dialogue
- “Por que um tinteiro?”
	Julio: “Você verá!”
	=> question_hub
- “Por que você deixa a área dos animais trancada?”
	do DialogueData.set_mood("Julio", DialogueData.JulioMoods.SILLY_SAD)
	Julio: “Porque, bem... em um lugar onde todos estão famintos, é perigoso deixar os bichinhos acessíveis a todos...”
	=> question_hub
- > Finalizar diálogo <
	=> finish_dialogue

~ finish_dialogue
if CharacterData.Julio.get_status("get_inkwell") == 0:
	Você: “Tudo bem, certo.”
	do DialogueData.set_mood("Julio", DialogueData.JulioMoods.IDLE_HAPPY)
	Julio: “Obrigado!”
	do CharacterData.Julio.give_task("get_inkwell")
=> END!


~ waiting_completion
do DialogueData.set_mood("Julio", DialogueData.JulioMoods.IDLE_DEFAULT)
Julio: “Você poderia por favor trazer o tinteiro para mim? Quero poder realizar meu último desejo...”
- > Concluir tarefa <[if InventoryManager.selected_item == CharacterData.Item.inkwell or InventoryManager.selected_item == CharacterData.Item.toxic_plant /] => complete_task
- > Repetir perguntas < => question_hub
- > Finalizar diálogo < => END!
=> END


~ complete_task
if InventoryManager.selected_item == CharacterData.Item.inkwell:
	do CharacterData.Julio.item_animals = "ink"
	=> animals_ink
elif InventoryManager.selected_item == CharacterData.Item.toxic_plant:
	do CharacterData.Julio.item_animals = "plant"
	=> animals_plant
=> END

~ animals_ink
do DialogueData.set_mood("Julio", DialogueData.JulioMoods.INTENSE_DEFAULT)
Julio: “Franciso! Olá! Ah, você parece cansado. Está tudo bem?”
Você: [font_size=20]“É, vocês ficam me pedindo coisa...[/font_size] Sim, claro. Aqui está a tinta.”
do DialogueData.set_mood("Julio", DialogueData.JulioMoods.INTENSE_SURPRISED)
Julio: “Oi?”
Você: “Oi?”
do DialogueData.set_mood("Julio", DialogueData.JulioMoods.IDLE_SAD)
do InventoryManager.use_item()
Julio: “Ah. A tinta. Sim, obrigado. Pode me seguir até a área dos animais agora.”
do WorldStateManager.play_animals_ink_cutscene()
=> END!


~ animals_plant
do DialogueData.set_mood("Julio", DialogueData.JulioMoods.IDLE_HAPPY)
Julio: “Olá! Como você está?”
Você: “Bom... indo.”
do DialogueData.set_mood("Julio", DialogueData.JulioMoods.INTENSE_HAPPY)
Julio: “Hum! Melhor que ruim!... [do DialogueData.set_mood("Julio", DialogueData.JulioMoods.IDLE_SERIOUS)]Você trouxe o tinteiro?”
Você: “Sobre isso... mil desculpas, Julio. Mas, peguei isso do Sanson. Ele me disse que tem como o triturar em uma pastinha e usar como tinta, se é isso que você-”
do DialogueData.set_mood("Julio", DialogueData.JulioMoods.IDLE_HAPPY)
Julio: “Perfeito.”
Julio: “Por favor, me entregue”
do InventoryManager.use_item()
do CharacterData.Julio.complete_task("get_inkwell")
Você: “Cuidado, Sanson disse para não ingerir.”
Julio: “Venha comigo. Pode me seguir até a área dos animais.”
do WorldStateManager.play_animals_plant_cutscene()
=> END!