~ start
do DialogueData.set_mood("Julio", DialogueData.JulioMoods.IDLE_HAPPY)
Julio: Olá! (Vou sempre dizer essa fala.)
match CharacterData.Julio.quest_status["key_for_julio"]:
	when [false, false]
		=> give_key_task
	when [true, false]
		=> receive_key
	when [true, true]
		=> after_task


~ give_key_task
do DialogueData.set_mood("Julio", DialogueData.JulioMoods.INTENSE_SAD)
Julio: Perdi minha chave... será que você poderia encontrar?
- Não! => END
- Sim!
Julio: Eba! Obrigado!
do CharacterData.Julio.quest_status["key_for_julio"] = [true, false]
do TaskManager.give_task("key_for_julio", "Traga uma chave para Julio.")
=> END

~ receive_key
- Tchau! => END
- Entregar chave [if InventoryManager.selected_item == CharacterData.Julio.key_needed /]
	Julio: MEU DEUS!
	Julio: Você trouxe minha chave! To muito feliz. Tchau.
do CharacterData.Julio.quest_status["key_for_julio"] = [true, true]
do InventoryManager.use_item()
do TaskManager.complete_task("key_for_julio")
=> END

~ after_task
Julio: Lembra de quando você trouxe minha chave...?
Julio: Foi tão legal!
=> END